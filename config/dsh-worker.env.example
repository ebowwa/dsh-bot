# dsh-worker env — copy to ~/.dsh-worker/env on the worker box, chmod 600.
# Sourced by the service/cron line (see docs/decoupled-worker.md).
#
# NEVER commit this file; it holds live credentials. The token lifecycle:
# - GH_TOKEN is the worker's BOT_PAT. Least privilege per consumer is a
#   deployment decision: one PAT covering every configured repo, or a
#   separate worker per repo/token pair (the worker only ever acts on the
#   repos listed in DSH_WORKER_REPOS).
# - DOPPLER_SERVICE_TOKEN is REQUIRED — the agent launches only through
#   `doppler run --token ...`; without it the driver exits 2 (typed guard,
#   added after the review round on PR #45). Keep the token in the env
#   FILE, never in the cron/unit line (crontab -l and the unit file are
#   world-readable).

GH_TOKEN=ghp_replace_me                 # required
DOPPLER_SERVICE_TOKEN=dp.st.replace_me  # required

# Where the dsh-bot toolkit lives on this box (clone once, keep updated):
DSH_BOT_DIR="$HOME/dsh-bot"

# Consumer repos this worker serves (space or comma separated):
DSH_WORKER_REPOS="ebowwa/secondsee ebowwa/ANE"

# Optional tuning (defaults shown):
# DSH_WORKER_MODEL=zai/glm-5.3
# DSH_WORKER_REVIEW_MODEL=zai/glm-5.2
# DSH_WORKER_REVIEW_RULES_FILE=REVIEW.md
# DSH_WORKER_DATA_ROOT="$HOME/.dsh-worker"
# DSH_WORKER_TIMEOUT_MIN=120
# DSH_WORKER_QUEUE_LABEL=dsh/queued
# DSH_WORKER_ACK_MARKER=dsh:ack
# DSH_WORKER_KEEP_RUNS=10